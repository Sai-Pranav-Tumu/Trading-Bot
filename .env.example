# ==============================================================================
# Indian Stock Algorithmic Trading Bot - Environment Configuration
# ==============================================================================

# Execution Mode: Set to True for risk-free paper trading, False for live broker API
PAPER_TRADING=True

# Capital & Risk Parameters (INR)
INITIAL_CAPITAL=100000.0
MAX_DRAWDOWN_PCT=5.0
DAILY_MAX_LOSS_PCT=2.5
RISK_PER_TRADE_PCT=1.0

# Graduation Gatekeeper Thresholds
GRADUATION_PROFIT_TARGET_PCT=15.0
GRADUATION_MIN_TRADES=30
GRADUATION_MIN_WIN_RATE_PCT=50.0
GRADUATION_MAX_DRAWDOWN_PCT=5.0

# Broker API Integration (Unlocked once graduated or for live testing)
# Options: PAPER, ZERODHA, ANGELONE, DHAN, FYERS
BROKER_NAME=PAPER
BROKER_API_KEY=your_broker_api_key_here
BROKER_API_SECRET=your_broker_api_secret_here
BROKER_CLIENT_ID=your_client_id_here
BROKER_TOTP_KEY=your_totp_secret_token_here

# Market Data Settings
DATA_TIMEFRAME=15m
MARKET_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
